{
  "projects": {
    "project-a": "~/git/project-a/docs/transcripts",
    "project-b": "~/git/project-b/docs/transcripts"
  },
  "project_hints": {
    "project-a": "keywords, systems or people that identify this project"
  },
  "default_output": "~/git/plaud-sync/docs/transcripts",
  "timezone": "Europe/Prague",
  "language": "en",
  "auto_commit": false,
  "process_bookmarks": false,
  "wispr": {
    "enabled": false,
    "data_dir": "~/Library/Application Support/Wispr Flow",
    "keep_wispr_summary": true
  },
  "recorder": {
    "enabled": false,
    "adb": "adb"
  },
  "visuals": {
    "enabled": false,
    "screenshot_dirs": [
      "~/Desktop"
    ],
    "phone_dirs": [
      "/sdcard/DCIM/Camera",
      "/sdcard/Pictures/Screenshots"
    ],
    "tail_minutes": 30,
    "max_width": 1600,
    "adb": "adb",
    "autocapture": {
      "dir": "~/Pictures/plaud-autocapture",
      "interval_s": 3,
      "max_hours": 3,
      "retention_days": 14,
      "max_captions": 30
    }
  }
}
